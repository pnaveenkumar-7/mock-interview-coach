# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for session signing and security
# Replace with a secure random key in production
SECRET_KEY=replace-this-with-a-secure-random-secret-key

# Database Configuration (SQLite default inside instance folder)
DATABASE_URL=sqlite:///app.db

# Seed Admin Account
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
